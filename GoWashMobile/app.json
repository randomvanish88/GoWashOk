{
  "expo": {
    "name": "GoWash POS",
    "slug": "gowash-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.gowash.pos"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gowash.pos",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "entrypoint": "index.web.js"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GoWash to access your camera"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GoWash to access your photos",
          "cameraPermission": "Allow GoWash to access your camera"
        }
      ]
    ]
  }
}
